# Configuration du serveur
PORT=5000

# Connexion PostgreSQL (Prisma)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/todoapp?schema=public"

# Clé de chiffrement pour les tokens JWT
JWT_SECRET="your_jwt_super_secret_key_change_it_in_production"
